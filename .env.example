# ==============================================================================
# CONFIGURAÇÕES DO AUTO-ANIVERSÁRIO AI (.env)
# ==============================================================================

# 1. API KEY DO GOOGLE GEMINI (Obtenha em: https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_api_aqui

# 2. META WHATSAPP CLOUD API (Obtenha em: https://developers.facebook.com/)
WHATSAPP_TOKEN=seu_access_token_do_whatsapp_cloud_api
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_meta
WEBHOOK_VERIFY_TOKEN=meu_token_de_verificacao_secreto_123

# 3. PAGAMENTO PIX (Mercado Pago / Gateway)
MERCADOPAGO_ACCESS_TOKEN=seu_access_token_mercadopago
PIX_VALOR_PADRAO=9.90

# 4. CONFIGURAÇÕES DO SERVIDOR LOCAL
PORT=8005
HOST=0.0.0.0
